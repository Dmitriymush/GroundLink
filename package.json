{
  "name": "GroundLink",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "dmushat",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "config": "tsx src/scripts/build-config.ts",
    "dev": "vite --port 27015",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build-no-lint": "vite build && electron-builder",
    "preview": "vite preview",
    "rebuild": "@electron/rebuild",
    "postinstall": "electron-builder install-app-deps",
    "migrate-api": "node scripts/migrate-api.js",
    "rotator-sim": "node scripts/rotator-simulator.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.3.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@types/inquirer": "^8.2.5",
    "@types/lodash": "^4.14.200",
    "@types/node": "^20.8.4",
    "@types/node-hid": "^1.3.2",
    "@types/uuid": "^9.0.5",
    "@vitejs/plugin-vue": "^4.3.3",
    "@vue/tsconfig": "^0.4.0",
    "electron": "^26.4.3",
    "electron-builder": "25.1.7",
    "glob": "^10.3.10",
    "inquirer": "^8.2.5",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "5.6.2",
    "vite": "^4.4.9",
    "vite-plugin-electron": "^0.14.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-native": "^0.2.0",
    "vite-plugin-vuetify": "^1.0.2",
    "vue": "^3.3.4",
    "vue-tsc": "2.0.29",
    "vuetify": "^3.7.18"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.17.0",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.3",
    "commander": "^12.1.0",
    "hwid": "^0.5.0",
    "lodash": "^4.17.21",
    "needle": "^3.3.1",
    "node-hid": "^2.1.2",
    "pinia": "^2.1.7",
    "serialport": "^13.0.0",
    "uuid": "^9.0.1",
    "vue-router": "^4.2.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./svg": "./dist/svg.js",
    "./html": "./dist/html.js",
    "./package.json": "./package.json"
  }
}
